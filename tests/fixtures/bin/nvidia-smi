#!/usr/bin/env bash
set -euo pipefail

if [[ "${MOCK_PROFILE:-}" != cuda* ]]; then
  exit 1
fi

# NVIDIA Tegra (Jetson) parts report memory.* as [N/A]: the GPU has no private
# VRAM and allocates from the same pool as the CPU. cuda_tegra models a current
# release (GPU- prefixed UUID, --id= selection, numeric compute-app PIDs);
# cuda_tegra_legacy models an older one that supports none of those.
if [[ "$MOCK_PROFILE" == cuda_tegra* ]]; then
  if [ "$MOCK_PROFILE" = "cuda_tegra_legacy" ]; then
    tegra_uuid='cd71ddd4-7e01-5949-a9ea-47e27adf0e3c'
    tegra_name='Mock Tegra Orin (nvgpu)'
    tegra_cc='8.7'
  else
    tegra_uuid='GPU-tegra-thor-0000'
    tegra_name='Mock Tegra Thor'
    tegra_cc='11.0'
  fi
  case "$*" in
    *--query-compute-apps=*)
      if [ "$MOCK_PROFILE" = "cuda_tegra_legacy" ]; then
        printf '%s\n' "[N/A], $tegra_uuid, [N/A]"
      elif [ -n "${MOCK_NVIDIA_COMPUTE_APPS_FILE:-}" ] \
        && [ -r "${MOCK_NVIDIA_COMPUTE_APPS_FILE}" ]; then
        sed -n '/[^[:space:]]/p' "$MOCK_NVIDIA_COMPUTE_APPS_FILE"
      else
        printf '%s\n' "4242, $tegra_uuid, 0"
      fi
      ;;
    *--id=*)
      if [ "$MOCK_PROFILE" = "cuda_tegra_legacy" ]; then
        printf 'No devices were found\n'
      else
        case "$*" in
          *compute_cap*) printf '%s, %s\n' "$tegra_uuid" "$tegra_cc" ;;
          *) printf '%s\n' "$tegra_uuid" ;;
        esac
      fi
      ;;
    *--query-gpu=index,uuid,name,display_active,memory.total,compute_cap*)
      printf '%s\n' "0, $tegra_uuid, $tegra_name, Disabled, [N/A], $tegra_cc" ;;
    *--query-gpu=uuid,memory.total,memory.used,memory.free*)
      printf '%s\n' "$tegra_uuid, [N/A], [N/A], [N/A]" ;;
    *--query-gpu=uuid,compute_cap*)
      printf '%s, %s\n' "$tegra_uuid" "$tegra_cc" ;;
    *--query-gpu=uuid*)
      printf '%s\n' "$tegra_uuid" ;;
    *) exit 1 ;;
  esac
  exit 0
fi

case "$*" in
  *--query-gpu=uuid,memory.total,memory.used,memory.free*)
    if [ "$MOCK_PROFILE" = "cuda_triple" ]; then
      for row in \
        'GPU-large-0,81920,1024,80896' \
        'GPU-large-1,81920,2048,79872' \
        'GPU-large-2,81920,3072,78848'; do
        IFS=, read -r gpu_uuid total_mib base_used_mib base_free_mib <<<"$row"
        runner_used_mib=0
        if [ -n "${MOCK_OLLAMA_GPU_USAGE_DIR:-}" ] \
          && [ -d "$MOCK_OLLAMA_GPU_USAGE_DIR" ]; then
          runner_used_mib=$(awk -F, -v wanted="$gpu_uuid" \
            '$1 == wanted { total += $2 } END { print total + 0 }' \
            "$MOCK_OLLAMA_GPU_USAGE_DIR"/*.csv 2>/dev/null || printf 0)
        fi
        used_mib=$((base_used_mib + runner_used_mib))
        free_mib=$((base_free_mib - runner_used_mib))
        [ "$free_mib" -ge 0 ] || free_mib=0
        printf '%s, %s, %s, %s\n' \
          "$gpu_uuid" "$total_mib" "$used_mib" "$free_mib"
      done
    else
      printf '%s\n' 'GPU-dedicated, 24576, 1024, 23552'
    fi
    ;;
  *--query-compute-apps=pid,gpu_uuid,used_gpu_memory*)
    # Tests can atomically replace this file to model process arrival,
    # allocation growth, and process departure while the broker is running.
    if [ -n "${MOCK_NVIDIA_COMPUTE_APPS_FILE:-}" ] \
      && [ -r "$MOCK_NVIDIA_COMPUTE_APPS_FILE" ]; then
      sed -n '/[^[:space:]]/p' "$MOCK_NVIDIA_COMPUTE_APPS_FILE"
    fi
    ;;
  *--query-gpu=index,uuid,name,display_active,memory.total,compute_cap*)
    if [ "$MOCK_PROFILE" = "cuda_display" ]; then
      printf '%s\n' '0, GPU-display, Mock CUDA Display 12GB, Enabled, 12288, 8.6'
    elif [ "$MOCK_PROFILE" = "cuda_triple" ]; then
      printf '%s\n' \
        '0, GPU-large-0, Mock CUDA 80GB, Disabled, 81920, 8.0' \
        '1, GPU-large-1, Mock CUDA 80GB, Disabled, 81920, 8.0' \
        '2, GPU-large-2, Mock CUDA 80GB, Disabled, 81920, 8.0'
    elif [ "$MOCK_PROFILE" = "cuda_mixed" ]; then
      printf '%s\n' \
        '0, GPU-large-0, Mock CUDA 80GB, Disabled, 81920, 8.0' \
        '1, GPU-large-1, Mock CUDA 48GB, Disabled, 49152, 8.0'
    else
      printf '%s\n' \
        '0, GPU-dedicated, Mock CUDA 24GB, Disabled, 24576, 8.6' \
        '1, GPU-display, Mock CUDA Display 12GB, Enabled, 12288, 8.6' \
        '2, GPU-small, Mock CUDA 2GB, Enabled, 2048, 6.1'
    fi
    ;;
  *--query-gpu=uuid,memory.total,compute_cap*)
    if [ "$MOCK_PROFILE" = "cuda_triple" ]; then
      printf '%s\n' 'GPU-large, 81920, 8.0'
    elif [ "$MOCK_PROFILE" = "cuda_mixed" ]; then
      printf '%s\n' 'GPU-large, 49152, 8.0'
    else
      printf '%s\n' 'GPU-dedicated, 24576, 8.6'
    fi
    ;;
  *) exit 1 ;;
esac
